{
  "name": "land-of-good-places",
  "private": true,
  "version": "0.2.0",
  "description": "A cute, cosy 3D theme-park game. By Eleri age 6, and Jim age 44.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:text && npm run check:shop-spacing && npm run check:gondola-sightline && npm run check:hop-clearance && tsc --noEmit && npm run check:brevity && npm run check:assets && npm run check:hat-fit && npm run check:glasses-fit && npm run check:hood-face && npm run check:baked-face && npm run check:character-parity && npm run check:hair && npm run check:crowd && npm run check:ride-camera && npm run check:orientation && npm run check:sky-view && npm run check:waypoints && npm run check:park && npm run check:jitter && npm run check:rail-race && npm run check:cart-shape && npm run check:tie-frame && npm run check:cruiser-solves && npm run check:cruiser-turn-radius && npm run check:backpack-peek && vite build",
    "check:text": "node scripts/check-text-sizes.mjs",
    "check:brevity": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/check-copy-brevity.mts",
    "check:hat-fit": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-hat-fit.mts",
    "check:glasses-fit": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-glasses-fit.mts",
    "check:hood-face": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/check-hood-face.mts",
    "check:baked-face": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/check-baked-face.mts",
    "check:hair": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/check-hair.mts",
    "check:assets": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/check-asset-contract.mts",
    "check:crowd": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/trace-npc-driver.mts",
    "check:ride-camera": "node --experimental-strip-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/trace-ride-camera.mts",
    "check:orientation": "node --experimental-strip-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-orientation-math.mts",
    "check:sky-view": "node --experimental-strip-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-sky-view.mts",
    "check:waypoints": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/check-waypoints.mts",
    "check:park": "node --experimental-transform-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-park.mts",
    "check:jitter": "node --experimental-transform-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-npc-jitter.mts",
    "check:rail-race": "node --experimental-transform-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-rail-race.mts",
    "check:tie-frame": "node --experimental-transform-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-tie-frame.mts",
    "check:cruiser-solves": "node --experimental-transform-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-cruiser-solves.mts",
    "check:cruiser-turn-radius": "node --experimental-transform-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-cruiser-turn-radius.mts",
    "check:cart-shape": "node --experimental-transform-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-cart-shape.mts",
    "check:backpack-peek": "node --experimental-transform-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-backpack-peek.mts",
    "measure:rail-radii": "node --experimental-transform-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-rail-radii.mts",
    "check:shop-spacing": "node scripts/checkShopSpacing.mjs",
    "check:gondola-sightline": "node scripts/checkGondolaSightline.mjs",
    "check:hop-clearance": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-hop-clearance.mts",
    "check:character-parity": "node --experimental-strip-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-character-parity.mts",
    "export:kid": "node --experimental-strip-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/export-kid-glb.mts",
    "pack:kid": "node --experimental-strip-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/pack-kid-asset.mts",
    "blend:kid": "blender --background --factory-startup --python art/blend/kid_roundtrip.py && npm run pack:kid",
    "pack:cart": "node --experimental-strip-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/pack-cart-asset.mts",
    "blend:cart": "blender --background --factory-startup --python art/blend/cart_export.py && npm run pack:cart",
    "pack:duckbar": "node --experimental-strip-types --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/pack-duckbar-asset.mts",
    "blend:duckbar": "blender --background --factory-startup --python art/blend/duckbar_export.py && npm run pack:duckbar",
    "check:wall-tunnelling": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-wall-tunnelling.mts",
    "check:all": "npm run build && npm run test:procgen && npm run check:wall-tunnelling",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sweep:seeds": "node --experimental-transform-types --import ./scripts/ts-extension-resolver-register.mjs scripts/sweep-park-seeds.mts",
    "test:procgen": "vitest run",
    "test:procgen:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
