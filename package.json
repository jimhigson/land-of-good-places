{
  "name": "land-of-good-places",
  "private": true,
  "version": "0.2.0",
  "description": "A cute, cosy 3D theme-park game. By Eleri age 6, and Jim age 44.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:text && tsc --noEmit && npm run check:assets && vite build",
    "check:text": "node scripts/check-text-sizes.mjs",
    "check:assets": "node --experimental-strip-types --import ./scripts/ts-extension-resolver-register.mjs scripts/check-asset-contract.mts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
