{
  "name": "land-of-good-places",
  "private": true,
  "version": "0.2.0",
  "description": "A cute, cosy 3D theme-park game. By Eleri age 6, and Jim age 44.",
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "dev": "vite",
    "check": "pnpm run check:text && pnpm run check:shop-spacing && pnpm run check:gondola-sightline && pnpm run check:hop-clearance && pnpm run check:deck-fallthrough && tsc --noEmit && pnpm run typecheck:test && pnpm run check:brevity && pnpm run check:assets && pnpm run check:hat-fit && pnpm run check:glasses-fit && pnpm run check:hood-face && pnpm run check:baked-face && pnpm run check:character-parity && pnpm run check:hair && pnpm run check:crowd && pnpm run check:speech-bubbles && pnpm run check:ride-camera && pnpm run check:slide-rider && pnpm run check:orientation && pnpm run check:sky-view && pnpm run check:space-night && pnpm run check:waypoints && pnpm run check:park && pnpm run check:park-map && pnpm run check:hud-during-rides && pnpm run check:solve-cost && pnpm run check:jitter && pnpm run check:castle && pnpm run check:castle-floors && pnpm run check:hotel && pnpm run check:tap-spacing && pnpm run check:nav-routes && pnpm run check:rail-race && pnpm run check:cart-shape && pnpm run check:tie-frame && pnpm run check:cruiser-solves && pnpm run check:cruiser-turn-radius && pnpm run check:cruiser-clearance && pnpm run check:castle-window && pnpm run check:backpack-peek && pnpm run check:statue-occlusion && pnpm run check:keyring-hang && pnpm run check:climb-wave && pnpm run check:cat-bus && pnpm run check:cat-bus-suspension && pnpm run check:bus-journey && pnpm run check:park-boot && pnpm run check:arrival-completes",
    "build": "vite build",
    "check:text": "node scripts/check-text-sizes.mjs",
    "check:brevity": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/check-copy-brevity.mts",
    "check:hat-fit": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-hat-fit.mts",
    "check:glasses-fit": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-glasses-fit.mts",
    "check:hood-face": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/check-hood-face.mts",
    "check:baked-face": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/check-baked-face.mts",
    "check:hair": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/check-hair.mts",
    "check:assets": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/check-asset-contract.mts",
    "check:speech-bubbles": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-speech-bubbles.mts",
    "check:crowd": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/trace-npc-driver.mts && pnpm run check:npc-perch && pnpm run check:npc-separation && pnpm run check:npc-dispersal && pnpm run check:npc-presence",
    "check:npc-perch": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-npc-perch.mts",
    "check:npc-separation": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-npc-separation.mts",
    "check:npc-dispersal": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-npc-dispersal.mts",
    "check:npc-presence": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-npc-presence.mts",
    "check:ride-camera": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/trace-ride-camera.mts",
    "check:orientation": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-orientation-math.mts",
    "check:sky-view": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-sky-view.mts",
    "check:space-night": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-space-night.mts",
    "check:waypoints": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/check-waypoints.mts",
    "check:park": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-park.mts",
    "check:solve-cost": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-solve-cost.mts",
    "check:castle": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-castle.mts",
    "check:jitter": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-npc-jitter.mts",
    "check:hotel": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-hotel.mts",
    "check:tap-spacing": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-tap-spacing.mts",
    "check:nav-routes": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-nav-routes.mts",
    "check:rail-race": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-rail-race.mts",
    "check:tie-frame": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-tie-frame.mts",
    "check:castle-window": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-castle-window.mts",
    "check:cruiser-solves": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-cruiser-solves.mts",
    "check:cruiser-turn-radius": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-cruiser-turn-radius.mts",
    "check:slide-rider": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-slide-rider.mts",
    "check:cart-shape": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-cart-shape.mts",
    "check:backpack-peek": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-backpack-peek.mts",
    "measure:solver-budget": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-solver-budget.mts",
    "check:cruiser-clearance": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-cruiser-clearance.mts",
    "check:climb-wave": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-climb-wave.mts",
    "check:keyring-hang": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-keyring-hang.mts",
    "measure:rail-radii": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-rail-radii.mts",
    "measure:cruiser-fingerprint": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/fingerprint-cruiser.mts",
    "measure:slide-comfort": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-slide-comfort.mts",
    "measure:slide-towers": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-slide-towers.mts",
    "measure:slide-fingerprint": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/fingerprint-slide.mts",
    "measure:slide-boot": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-slide-boot.mts",
    "check:shop-spacing": "node scripts/checkShopSpacing.mjs",
    "check:gondola-sightline": "node scripts/checkGondolaSightline.mjs",
    "check:hop-clearance": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-hop-clearance.mts",
    "check:character-parity": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-character-parity.mts",
    "export:kid": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/export-kid-glb.mts",
    "pack:kid": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/pack-kid-asset.mts",
    "blend:kid": "blender --background --factory-startup --python art/blend/kid_roundtrip.py && pnpm run pack:kid",
    "pack:cart": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/pack-cart-asset.mts",
    "blend:cart": "blender --background --factory-startup --python art/blend/cart_export.py && pnpm run pack:cart",
    "pack:duckbar": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/pack-duckbar-asset.mts",
    "blend:duckbar": "blender --background --factory-startup --python art/blend/duckbar_export.py && pnpm run pack:duckbar",
    "render:bridge": "blender --background --factory-startup --python-exit-code 1 --python art/blend/bridge_stones_render.py",
    "dump:bridge-constants": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/dump-bridge-constants.mts",
    "pack:bridge-stones": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/pack-bridge-stones-asset.mts",
    "blend:bridge-stones": "blender --background --factory-startup --python-exit-code 1 --python art/blend/bridge_stones_build.py && blender --background --factory-startup --python-exit-code 1 --python art/blend/bridge_stones_export.py && pnpm run pack:bridge-stones",
    "pack:hotel": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/pack-hotel-asset.mts",
    "blend:hotel": "blender --background --factory-startup --python-exit-code 1 --python art/blend/hotel_build.py && blender --background --factory-startup --python-exit-code 1 --python art/blend/hotel_export.py && pnpm run pack:hotel",
    "pack:castle": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/pack-castle-asset.mts",
    "blend:castle": "blender --background --factory-startup --python-exit-code 1 --python art/blend/castle_build.py && blender --background --factory-startup --python-exit-code 1 --python art/blend/castle_export.py && pnpm run pack:castle",
    "render:castle": "blender --background --factory-startup --python-exit-code 1 --python art/blend/castle_render.py",
    "check:wall-tunnelling": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-wall-tunnelling.mts",
    "check:deck-fallthrough": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-deck-fallthrough.mts",
    "check:all": "pnpm run check && pnpm run build && pnpm run test:procgen && pnpm run check:wall-tunnelling",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sweep:seeds": "node --import ./scripts/ts-extension-resolver-register.mjs scripts/sweep-park-seeds.mts",
    "test:procgen": "vitest run",
    "test:procgen:watch": "vitest",
    "check:statue-occlusion": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-statue-occlusion.mts",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "check:cat-bus": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-cat-bus.mts",
    "check:bus-journey": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-bus-journey.mts",
    "check:park-boot": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-park-boot.mts",
    "check:arrival-completes": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-arrival-completes.mts",
    "check:arrival-starts": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-arrival-starts.mts",
    "check:update-adoption": "node --no-warnings scripts/check-update-adoption.mts",
    "check:live-version": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-live-version.mts",
    "check:deep-links": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-deep-links.mts",
    "check:walking": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-walking.mts",
    "check:frame-time": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-frame-time.mts",
    "check:park-map": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-park-map.mts",
    "check:hud-during-rides": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-hud-during-rides.mts",
    "qa:hud-during-rides": "node --no-warnings scripts/qa-hud-during-rides.mjs",
    "check:cat-bus-suspension": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-cat-bus-suspension.mts",
    "measure:kid-landmarks": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/measure-kid-landmarks.mts",
    "check:castle-floors": "node --no-warnings --import ./scripts/ts-extension-resolver-register.mjs scripts/check-castle-floors.mts"
  },
  "dependencies": {
    "three": "^0.185.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
