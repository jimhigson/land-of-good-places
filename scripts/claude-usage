#!/usr/bin/env python3
"""claude-usage — report this account's current Claude usage window.

There is no dedicated usage endpoint for subscription (Pro/Max) accounts: the
Admin API's Usage & Cost API needs an org:admin-scoped credential, and a
normal `claude login` session does not carry one (confirmed: this machine's
stored session has scopes user:file_upload/user:inference/user:mcp_servers/
user:profile only). What every response DOES carry, for the token's own
request, is a set of anthropic-ratelimit-* headers — so this makes one
minimal (1 output token) request and reads those back. No secret is stored
in this script; the token is read fresh from the OS credential store each run
and never printed or logged.

macOS only: reads Claude Code's OAuth session from the login Keychain, entry
"Claude Code-credentials" (`security find-generic-password`). On Linux the
same JSON lives in plaintext at ~/.claude/.credentials.json instead, at the
same claudeAiOauth.accessToken path — swap load_token() for that path if you
need to run this there.
"""

from __future__ import annotations

import json
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime

SERVICE = "Claude Code-credentials"
MODEL = "claude-haiku-4-5-20251001"  # cheapest model; this call costs ~1 token


def load_token() -> str:
    try:
        raw = subprocess.run(
            ["security", "find-generic-password", "-s", SERVICE, "-w"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        sys.exit(
            f"Could not read '{SERVICE}' from the macOS Keychain — "
            "is Claude Code logged in on this machine?"
        )
    return json.loads(raw)["claudeAiOauth"]["accessToken"]


def fetch_ratelimit_headers(token: str) -> dict[str, str]:
    body = json.dumps(
        {
            "model": MODEL,
            "max_tokens": 1,
            "messages": [{"role": "user", "content": "hi"}],
        }
    ).encode()
    req = urllib.request.Request(
        "https://api.anthropic.com/v1/messages",
        data=body,
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "anthropic-version": "2023-06-01",
            "anthropic-beta": "oauth-2025-04-20",
        },
    )
    try:
        with urllib.request.urlopen(req) as resp:
            headers = dict(resp.headers)
    except urllib.error.HTTPError as e:
        headers = dict(e.headers)
        if e.code >= 500 or not any(
            k.lower().startswith("anthropic-ratelimit") for k in headers
        ):
            sys.exit(f"Anthropic API error {e.code}: {e.read().decode(errors='replace')}")
    return {
        k.lower(): v for k, v in headers.items() if k.lower().startswith("anthropic-ratelimit")
    }


def fmt_reset(epoch: str) -> str:
    try:
        return datetime.fromtimestamp(int(epoch)).strftime("%a %H:%M")
    except (ValueError, OSError, TypeError):
        return epoch or "?"


def main() -> None:
    token = load_token()
    h = fetch_ratelimit_headers(token)
    if not h:
        sys.exit("No rate-limit headers in the response — the API shape may have changed.")

    def pct(key: str) -> str:
        v = h.get(key)
        return f"{float(v) * 100:.0f}%" if v is not None else "?"

    print(f"Status: {h.get('anthropic-ratelimit-unified-status', '?')}")
    print()
    print(
        f"  5-hour window:  {pct('anthropic-ratelimit-unified-5h-utilization')} used"
        f"  (resets {fmt_reset(h.get('anthropic-ratelimit-unified-5h-reset', ''))})"
    )
    print(
        f"  7-day window:   {pct('anthropic-ratelimit-unified-7d-utilization')} used"
        f"  (resets {fmt_reset(h.get('anthropic-ratelimit-unified-7d-reset', ''))})"
    )

    overage = h.get("anthropic-ratelimit-unified-overage-status")
    if overage:
        reason = h.get("anthropic-ratelimit-unified-overage-disabled-reason")
        extra = f" ({reason})" if reason else ""
        print(f"  Overage:        {overage}{extra}")


if __name__ == "__main__":
    main()
