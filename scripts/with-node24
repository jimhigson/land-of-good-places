#!/usr/bin/env bash
#
# Run a command under Node 24 — the version CI uses (.github workflows pin
# node-version: 24) and the version `check:park-boot` REQUIRES.
#
# Why this exists: the cloud dev container defaults to Node 22, and
# `scripts/check-park-boot.mts` drives generation by firing dynamic import()s
# without awaiting them and polling with setImmediate. On Node 22 + this repo's
# register-based TypeScript loader those un-awaited imports never settle, so the
# boot loop hangs at "measuring out the park" forever (0 work units). It is a
# loader bug, not a bug in the game or the check — every other check and the
# browser itself use ordinary awaited imports and are fine. Node 24 settles them.
#
# Usage:
#   scripts/with-node24 npm run check:park-boot
#   scripts/with-node24 npm run build          # the whole check suite
#   scripts/with-node24 node --version         # -> v24.x
#
set -euo pipefail

node24_bin() {
  # Newest installed v24 across the nvm dirs this container might use.
  ls -d /root/.nvm/versions/node/v24.*/bin "$HOME"/.nvm/versions/node/v24.*/bin 2>/dev/null \
    | sort -V | tail -1
}

BIN="$(node24_bin || true)"
if [ -z "${BIN:-}" ] || [ ! -x "$BIN/node" ]; then
  echo "with-node24: Node 24 not found; installing via nvm..." >&2
  export NVM_DIR="${NVM_DIR:-/root/.nvm}"
  for f in "$NVM_DIR/nvm.sh" /opt/nvm/nvm.sh /etc/profile.d/nvm.sh "$HOME/.nvm/nvm.sh"; do
    # shellcheck disable=SC1090
    [ -s "$f" ] && . "$f" && break
  done
  command -v nvm >/dev/null || { echo "with-node24: nvm not available on this box" >&2; exit 1; }
  nvm install 24 >&2
  BIN="$(node24_bin || true)"
fi

[ -n "${BIN:-}" ] && [ -x "$BIN/node" ] || { echo "with-node24: could not locate a Node 24 binary" >&2; exit 1; }

export PATH="$BIN:$PATH"
[ "$#" -gt 0 ] || { echo "with-node24: node $("$BIN/node" --version) ready on PATH; give a command to run" >&2; exit 0; }
exec "$@"
